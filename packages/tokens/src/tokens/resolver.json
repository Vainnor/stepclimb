{
  "name": "Stepclimb UI",
  "version": "2025.10",
  "description": "The shared scales, then one theme per brand and appearance. The default brand is Stepclimb's; vzdc is the plan's example organization brand.",
  "sets": {
    "base": { "sources": [{ "$ref": "base.json" }] }
  },
  "modifiers": {
    "theme": {
      "default": "default-light",
      "contexts": {
        "default-light": [{ "$ref": "themes/default-light.json" }],
        "default-dark": [{ "$ref": "themes/default-dark.json" }],
        "vzdc-light": [{ "$ref": "themes/vzdc-light.json" }],
        "vzdc-dark": [{ "$ref": "themes/vzdc-dark.json" }]
      }
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/base" }, { "$ref": "#/modifiers/theme" }]
}
