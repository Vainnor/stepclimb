# Copy to .env for local development and load it into your shell (`set -a; . ./.env; set +a`,
# or `dotenv` in a local .envrc); `just` does not read it. Matches deploy/compose/compose.yaml.
STEPCLIMB_DATABASE_URL=postgres://stepclimb:stepclimb-local@127.0.0.1:55432/stepclimb
STEPCLIMB_BIND=127.0.0.1:8080
# The address the browser opens. `just dev` serves the web app on :5173 and proxies to this
# server; the browser's same-origin Fetch Metadata passes the CSRF check either way.
STEPCLIMB_PUBLIC_URL=http://localhost:8080
# The AES-256-GCM key ring, `<id>:<base64 32 bytes>` entries, the first encrypts. This file is
# the published development key (the server warns about it); for real data set
# STEPCLIMB_ENCRYPTION_KEYS to `<id>:<key>` from `openssl rand -base64 32` instead.
STEPCLIMB_ENCRYPTION_KEYS_FILE=deploy/compose/development-encryption-keys
# sqlx's test macros and `cargo sqlx` read DATABASE_URL.
DATABASE_URL=postgres://stepclimb:stepclimb-local@127.0.0.1:55432/stepclimb
