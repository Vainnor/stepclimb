# Copy to .env for local development (`just` loads it). Matches deploy/compose/compose.yaml.
STEPCLIMB_DATABASE_URL=postgres://stepclimb:stepclimb-local@127.0.0.1:55432/stepclimb
STEPCLIMB_BIND=127.0.0.1:8080
# The AES-256-GCM key ring, `<id>:<base64 32 bytes>` entries, the first encrypts. This is the
# local development key from compose.yaml; generate a real one with `openssl rand -base64 32`.
STEPCLIMB_ENCRYPTION_KEYS=local:c3RlcGNsaW1iLWxvY2FsLWRldmVsb3BtZW50LWtleSE=
# sqlx's test macros and `cargo sqlx` read DATABASE_URL.
DATABASE_URL=postgres://stepclimb:stepclimb-local@127.0.0.1:55432/stepclimb
