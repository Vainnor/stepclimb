  "query": "SELECT id, sha256, size, mime, storage_key,\n                  (extract(epoch FROM created_at) * 1000000)::bigint AS \"created_at_us!\",\n                  (extract(epoch FROM updated_at) * 1000000)::bigint AS \"updated_at_us!\"\n           FROM files\n           WHERE org_id = $1 AND sha256 = $2\n           FOR KEY SHARE",
