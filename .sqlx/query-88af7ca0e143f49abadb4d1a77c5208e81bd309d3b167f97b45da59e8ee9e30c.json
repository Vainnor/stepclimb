{
  "db_name": "PostgreSQL",
  "query": "SELECT e.user_id, r.key, r.builtin, r.permissions\n         FROM enrollments e\n         JOIN roles r ON r.id = e.role_id AND (r.org_id IS NULL OR r.org_id = e.org_id)\n         WHERE e.org_id = $1 AND e.course_id = $2 AND e.user_id = ANY($3)\n         ORDER BY r.id\n         FOR KEY SHARE OF r",
