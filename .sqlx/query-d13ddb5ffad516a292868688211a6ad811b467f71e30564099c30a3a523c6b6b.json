  "query": "SELECT o.id, o.org_id, o.topic FROM outbox o\n         WHERE o.dispatched_at IS NULL\n           AND (o.topic, o.version) IN (SELECT * FROM unnest($1::text[], $2::integer[]))\n         ORDER BY o.id\n         LIMIT $3\n         FOR UPDATE OF o SKIP LOCKED",
