  "query": "SELECT r.key, r.builtin, r.permissions\n         FROM roles r\n         WHERE (r.org_id IS NULL OR r.org_id = $1)\n           AND r.id IN (SELECT e.role_id FROM enrollments e\n                        WHERE e.org_id = $1 AND e.course_id = $2 AND e.status = 'active')\n         ORDER BY r.id\n         FOR KEY SHARE",
