{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stepclimb",
  "version": "0.0.0",
  "identifier": "dev.stepclimb.shell",
  "build": {
    "frontendDist": "../../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --dir ../.. --filter web dev",
    "beforeBuildCommand": "pnpm --dir ../.. --filter web build"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Stepclimb", "width": 1200, "height": 800 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
